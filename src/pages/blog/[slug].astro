---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { title, excerpt, coverImage, publishedAt, category } = post.data;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  'master-class': 'Мастер-класс',
  'reviews': 'Отзывы',
  'how-to': 'Инструкция',
  'materials': 'Материалы',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout title={title} description={excerpt} image={coverImage}>
  <article>
    <div class="post-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Хлебные крошки">
          <a href="/">Главная</a>
          <span aria-hidden="true">›</span>
          <a href="/blog">Блог</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{title}</span>
        </nav>

        <span class="category-badge">{categoryLabels[category]}</span>
        <h1>{title}</h1>
        <time class="post-date" datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
      </div>
    </div>

    <div class="cover-wrap">
      <img src={coverImage} alt={title} class="cover-image" />
    </div>

    <div class="container post-body">
      <Content />
    </div>

    <div class="container post-footer">
      <a href="/blog" class="back-link">← Все статьи</a>
    </div>
  </article>
</Layout>

<style>
  .post-header {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 1.5rem 2rem;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Cover image — full width strip */
  .cover-wrap {
    width: 100%;
    max-height: 440px;
    overflow: hidden;
    background: var(--color-bg-subtle);
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Body prose */
  .post-body {
    padding-top: 2.5rem;
    padding-bottom: 1rem;
  }

  .post-body :global(h2) {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 2rem 0 0.6rem;
  }

  .post-body :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 1.5rem 0 0.4rem;
  }

  .post-body :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .post-body :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .post-body :global(strong) {
    font-weight: 600;
    color: var(--color-primary);
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-body :global(em:first-child) {
    display: block;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .post-body :global(.img-row),
  .post-body :global(.img-gallery) {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .post-body :global(.img-row) {
    grid-template-columns: 1fr 1fr;
  }

  .post-body :global(.img-gallery) {
    grid-template-columns: repeat(3, 1fr);
  }

  .post-body :global(.img-row > img),
  .post-body :global(.img-gallery > img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .post-body :global(.img-gallery) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post-footer {
    padding-bottom: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-hover);
  }
</style>
