---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProseContent from '../components/ProseContent.astro';

const entry = await getEntry('pages', 'about');
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description="Узнайте больше о мастерской UralBasket — плетёные изделия ручной работы из натуральной лозы."
>
  <ProseContent title={entry.data.title} breadcrumbLabel="О нас">
    <Content />
  </ProseContent>
</Layout>
