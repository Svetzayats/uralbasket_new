---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProseContent from '../components/ProseContent.astro';
import OrderForm from '../components/OrderForm.astro';
import Contacts from '../components/Contacts.astro';
import FAQ from '../components/FAQ.astro'

const entry = await getEntry('pages', 'about');
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description="Мастерская UralBasket — плетёные изделия ручной работы из натуральной лозы."
>
  <ProseContent title={entry.data.title} breadcrumbLabel="О нас">
    <Content />
    <Contacts />
    <p>Или оставьте заявку с вашими контактными данными — и мы свяжемся с вами в течение рабочего дня для уточнения деталей, сроков и стоимости.</p>
    <OrderForm compact/>
    <FAQ slot="wide" />
  </ProseContent>
</Layout>
