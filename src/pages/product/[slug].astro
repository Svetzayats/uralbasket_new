---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OrderForm from '../../components/OrderForm.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(product => product.data.published)
    .map(product => ({
      params: { slug: product.id },
      props: { product },
    }));
}

const { product } = Astro.props;
const { title, description, price, images, sizes, inStock, category } = product.data;

const sizesStr = sizes
  ? [
      sizes.diameter ? `⌀${sizes.diameter}` : null,
      sizes.width,
      sizes.depth,
      sizes.height,
    ].filter(Boolean).join(' x ') + ' см'
  : undefined;
const { Content } = await render(product);

const categoryLabels: Record<string, string> = {
  baskets: 'Корзины',
  trade: 'Торговое оборудование',
  design: 'Интерьер и дизайн',
  boxes: 'Сундуки и короба',
};
---

<Layout title={title} description={description}>
  <div class="container">
    <nav class="breadcrumb" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span aria-hidden="true">›</span>
      <a href={`/${category}`}>{categoryLabels[category]}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{title}</span>
    </nav>

    <div class="product-layout">
      <div class="gallery">
        {images.length > 0 ? (
          <>
            <div class="gallery-main">
              <button class="zoom-trigger" aria-label="Увеличить фото" id="zoom-trigger">
                <img
                  id="gallery-active"
                  src={images[0]}
                  alt={title}
                  class="main-image"
                />
                <span class="zoom-hint" aria-hidden="true">🔍</span>
              </button>
            </div>
            {images.length > 1 && (
              <ul class="gallery-thumbs">
                {images.map((src, i) => (
                  <li>
                    <button
                      class:list={['thumb-btn', { active: i === 0 }]}
                      data-src={src}
                      aria-label={`Фото ${i + 1}`}
                    >
                      <img src={src} alt={`${title} — фото ${i + 1}`} loading="lazy" />
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <div class="no-image" aria-label="Фото отсутствует" />
        )}
      </div>

      <div class="product-info">
        <h1>{title}</h1>

        <div class="meta-row">
          {price && <p class="price">{price}</p>}
          <span class:list={['stock-badge', inStock ? 'in-stock' : 'out-stock']}>
            {inStock ? 'В наличии' : 'Нет в наличии'}
          </span>
        </div>

        <p class="description">{description}</p>

        {sizes && (sizes.width || sizes.height || sizes.depth || sizes.diameter) && (
          <div class="sizes-block">
            <h2 class="sizes-heading">Размеры</h2>
            <dl class="sizes-grid">
              {sizes.diameter && <><dt>Диаметр</dt><dd>{sizes.diameter} см</dd></>}
              {sizes.width && <><dt>Ширина</dt><dd>{sizes.width} см</dd></>}
              {sizes.depth && <><dt>Глубина</dt><dd>{sizes.depth} см</dd></>}
              {sizes.height && <><dt>Высота</dt><dd>{sizes.height} см</dd></>}
            </dl>
          </div>
        )}

      </div>
    </div>

    {product.body && (
      <div class="product-body">
        <Content />
      </div>
    )}

    <div class="product-form-section">
      <h2 class="form-section-title">Оставить заявку на этот товар</h2>
      <OrderForm
        productSlug={product.id}
        productTitle={title}
        productDescription={description}
        productSizes={sizesStr}
        compact
      />
    </div>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Просмотр фото">
    <button class="lightbox-close" aria-label="Закрыть">✕</button>
    <img class="lightbox-img" src="" alt="" />
  </dialog>
</Layout>

<script>
  const mainImg = document.getElementById('gallery-active') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');
  const zoomTrigger = document.getElementById('zoom-trigger') as HTMLButtonElement | null;
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox-img');
  const lightboxClose = lightbox?.querySelector<HTMLButtonElement>('.lightbox-close');

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (mainImg) mainImg.src = btn.dataset.src ?? '';
      thumbBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  zoomTrigger?.addEventListener('click', () => {
    if (!lightbox || !lightboxImg || !mainImg) return;
    lightboxImg.src = mainImg.src;
    lightboxImg.alt = mainImg.alt;
    lightbox.showModal();
  });

  lightboxClose?.addEventListener('click', () => lightbox?.close());

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Gallery */
  .gallery-main {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
  }

  .zoom-trigger {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    background: none;
    padding: 0;
    cursor: zoom-in;
    position: relative;
  }

  .zoom-hint {
    position: absolute;
    bottom: 0.6rem;
    right: 0.6rem;
    background: rgba(0,0,0,0.45);
    color: #fff;
    font-size: 0.8rem;
    padding: 0.25rem 0.45rem;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .zoom-trigger:hover .zoom-hint {
    opacity: 1;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .zoom-trigger:hover .main-image {
    transform: scale(1.03);
  }

  /* Lightbox */
  .lightbox {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    position: fixed;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 4px;
    display: block;
  }

  .lightbox-close {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    color: #ffffff;
    font-size: 1.1rem;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.3);
  }

  .gallery-thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .thumb-btn {
    width: 72px;
    height: 72px;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    background: none;
    padding: 0;
    transition: border-color 0.15s;
  }

  .thumb-btn.active,
  .thumb-btn:hover {
    border-color: var(--color-accent);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-image {
    aspect-ratio: 4 / 3;
    background: var(--color-bg-subtle);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  /* Product info */
  h1 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stock-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 20px;
  }

  .in-stock {
    background: #d1f0da;
    color: #166534;
  }

  .out-stock {
    background: #fff3cd;
    color: #856404;
  }

  .description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .sizes-block {
    margin-bottom: 2rem;
  }

  .sizes-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
  }

  .sizes-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    row-gap: 0.3rem;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    width: fit-content;
    min-width: 180px;
  }

  .sizes-grid dt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .sizes-grid dd {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  /* Body content */
  .product-body {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    max-width: 720px;
  }

  .product-body :global(h2) {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 1.5rem 0 0.5rem;
  }

  .product-body :global(p) {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .product-body :global(ul),
  .product-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .product-body :global(li) {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .product-body :global(strong) {
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Order form section */
  .product-form-section {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .form-section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
