---
interface Props {
  title: string;
  breadcrumbLabel: string;
}
const { title, breadcrumbLabel } = Astro.props;
---

<div class="page-header">
  <div class="container">
    <nav class="breadcrumb" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{breadcrumbLabel}</span>
    </nav>
    <h1>{title}</h1>
  </div>
</div>

<div class="container prose-body">
  <div class="">
    <slot />
  </div>
  <slot name="wide" />
</div>

<style>
  .page-header {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 1.5rem 1.75rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container.narrow {
    max-width: 760px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    color: var(--color-primary);
  }

  .prose-body {
    padding: 2.5rem 1.5rem 4rem;
  }

  .prose-body .narrow {
    max-width: 760px;
    margin: 0 auto;
  }

  .prose-body :global(h2) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 2rem 0 0.6rem;
  }

  .prose-body :global(h3) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 1.5rem 0 0.4rem;
  }

  .prose-body :global(p) {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text);
    margin-bottom: 0.9rem;
  }

  .prose-body :global(ul),
  .prose-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose-body :global(li) {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .prose-body :global(strong) {
    font-weight: 600;
    color: var(--color-primary);
  }

  .prose-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-body :global(a:hover) {
    color: var(--color-hover);
  }

  .prose-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
</style>
