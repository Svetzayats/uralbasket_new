---
const navLinks = [
  { href: '/baskets',           label: 'Корзины' },
  { href: '/boxes',             label: 'Сундуки и короба' },
  { href: '/design',            label: 'Интерьер и дизайн' },
  { href: '/cribs',             label: 'Детские колыбели' },
  { href: '/display_equipment', label: 'Торговое оборудование' },
  { href: '/delivery',          label: 'Оплата и доставка' },
  { href: '/about',             label: 'О нас' },
  { href: '/blog',              label: 'Блог' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="nav" aria-label="Главная навигация">
    <a href="/" class="logo" aria-label="UralBasket — на главную">URALBASKET</a>

    <ul class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button class="menu-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-overflow" aria-label="Открыть меню">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-overflow" id="nav-overflow"></ul>
  </nav>
</header>

<script>
  function setupResponsiveNav() {
    const nav = document.querySelector('.nav') as HTMLElement | null;
    const row = document.getElementById('nav-links') as HTMLUListElement | null;
    const overflowMenu = document.getElementById('nav-overflow') as HTMLUListElement | null;
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    if (!nav || !row || !overflowMenu || !toggle) return;

    // Fixed original order, captured once — used to restore correct link
    // order when collapsing everything into the overflow menu below.
    const allItems = Array.from(row.children);
    const itemCount = allItems.length;
    const collapseBelow = 451;

    // scrollWidth doesn't capture overflow on right-aligned (justify-content:
    // flex-end) flex content, since it spills to the left instead of the
    // right — so measure the items' combined width directly.
    function rowOverflows() {
      let total = 0;
      for (const li of Array.from(row!.children)) total += (li as HTMLElement).getBoundingClientRect().width;
      return total > row!.clientWidth + 1;
    }

    function reflow() {
      if (window.innerWidth < collapseBelow) {
        // Below this width, no links stay inline — everything lives in the burger menu.
        for (const li of allItems) overflowMenu!.appendChild(li);
      } else {
        // Pull items back into the row while there's room for them.
        let pullGuard = itemCount + 1;
        while (overflowMenu!.firstElementChild && pullGuard-- > 0) {
          const first = overflowMenu!.firstElementChild;
          row!.appendChild(first);
          if (rowOverflows()) {
            overflowMenu!.insertBefore(first, overflowMenu!.firstElementChild);
            break;
          }
        }

        // Push items into overflow while the row doesn't fit.
        let pushGuard = itemCount + 1;
        while (rowOverflows() && row!.lastElementChild && pushGuard-- > 0) {
          overflowMenu!.insertBefore(row!.lastElementChild, overflowMenu!.firstElementChild);
        }
      }

      const hasOverflow = overflowMenu!.children.length > 0;
      toggle!.classList.toggle('visible', hasOverflow);
      if (!hasOverflow) {
        overflowMenu!.classList.remove('open');
        toggle!.setAttribute('aria-expanded', 'false');
      }
    }

    let raf = 0;
    function scheduleReflow() {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(reflow);
    }

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      overflowMenu.classList.toggle('open');
    });

    new ResizeObserver(scheduleReflow).observe(nav);
    reflow();
  }

  setupResponsiveNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    overflow: visible;
  }

  .nav {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .nav-link {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--color-primary);
    padding: 0.4rem 0.45rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle.visible {
    display: flex;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-primary);
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-overflow {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-primary);
    flex-direction: column;
    gap: 0;
    padding: 0;
  }

  .nav-overflow.open {
    display: flex;
  }

  .nav-overflow li {
    width: 100%;
  }

  .nav-overflow .nav-link {
    display: block;
    width: 100%;
    padding: 0.75rem 1.5rem;
    color: #ffffff;
    border-radius: 0;
    font-size: 0.95rem;
    white-space: normal;
  }

  .nav-overflow .nav-link:hover,
  .nav-overflow .nav-link.active {
    color: #ffffff;
    background: var(--color-hover);
  }
</style>
