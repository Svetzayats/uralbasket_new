---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<li class="faq-card">
  <h3 class="faq-card__question">{question}</h3>
  <p class="faq-card__answer">{answer}</p>
</li>

<style>
  .faq-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.75rem;
    list-style: none;
  }

  .faq-card__question {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .faq-card__answer {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
